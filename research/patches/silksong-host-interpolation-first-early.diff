+// RADV hands PerVertexKHR values to the second triangle of a quad in an order that does not match gl_BaryCoordKHR,
+// so full-screen passes show a diagonal seam. Pixel shaders that host interpolation can express skip the extension there.
+inline bool HostInterpolationPreferred(VkDriverId driver) {
+    return driver == VK_DRIVER_ID_MESA_RADV;
+}

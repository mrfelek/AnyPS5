+        auto secondInFlight = prepare(0, secondWords);
+        Require(firstInFlight->allocation.set != secondInFlight->allocation.set, "in-flight draws share a reused descriptor set");
+        firstInFlight.reset();
+        secondInFlight.reset();
+        complete();

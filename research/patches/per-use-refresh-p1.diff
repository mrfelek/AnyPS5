diff --git a/core/libs/prx/libSceAgcDriver/Graphics/include/TmpCommitterSplit.hpp b/core/libs/prx/libSceAgcDriver/Graphics/include/TmpCommitterSplit.hpp
new file mode 100644
index 000000000..4306f0bf1
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/include/TmpCommitterSplit.hpp
@@ -0,0 +1,106 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+// TEST ONLY (APS5_TMP_COMMITTER_SPLIT=1): sub-phase timers of the draw committer's per-draw work,
+// printed as one [tmp-split] line every 10 s. Not for upstream.
+namespace AgcDriver::Graphics::TmpSplit {
+
+enum Slot : std::size_t {
+    LookupKey, LookupFind, LookupRevalidate, LookupMoved, LookupAliases,
+    RecordStoreChecks, RecordBindingsSnapshots, RecordBindingsAllocate, RecordBindingsUpdate, RecordPassAccess, RecordStartPass, RecordCommands, RecordLeavePass,
+    Keep, PipelineMasked, PipelineCached, PipelineFramebuffer, PipelineDepth,
+    CommitLock, CommitLabels, CommitDrawAndSubmitDue,
+    SlotCount
+};
+
+inline constexpr std::array<const char*, SlotCount> Names{
+    "lookup.key", "lookup.find", "lookup.revalidate", "lookup.moved", "lookup.aliases",
+    "record.storeChecks", "record.bindings.snapshots", "record.bindings.allocate", "record.bindings.update", "record.passAccess", "record.startPass", "record.commands", "record.leavePass",
+    "keep", "pipeline.masked", "pipeline.cached", "pipeline.framebuffer", "pipeline.depth",
+    "commit.lock", "commit.labels", "commit.drawAndSubmitDue"};
+
+inline bool On() {
+    static const bool on = std::getenv("APS5_TMP_COMMITTER_SPLIT") != nullptr;
+    return on;
+}
+
+struct Totals {
+    std::array<std::atomic<std::uint64_t>, SlotCount> ns{};
+    std::array<std::atomic<std::uint64_t>, SlotCount> count{};
+    std::atomic<std::uint64_t> snapshots{0}, snapshotHits{0}, uploads{0}, uploadBytes{0}, freshBuffers{0}, movedWordBuffers{0}, writes{0};
+    std::atomic<std::int64_t> last{0};
+};
+
+inline Totals& Get() {
+    static Totals* totals = new Totals();
+    return *totals;
+}
+
+inline void Report() {
+    auto& totals = Get();
+    const auto now = std::chrono::steady_clock::now().time_since_epoch().count();
+    auto last = totals.last.load(std::memory_order_relaxed);
+    if (last == 0) {
+        totals.last.compare_exchange_strong(last, now);
+        return;
+    }
+    if (now - last < std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::seconds(10)).count()) return;
+    if (!totals.last.compare_exchange_strong(last, now)) return;
+    char line[2048];
+    int n = std::snprintf(line, sizeof(line), "[tmp-split] 10 s, ms (calls, us each):");
+    for (std::size_t i = 0; i < SlotCount && n > 0 && static_cast<std::size_t>(n) < sizeof(line); ++i) {
+        const auto ns = totals.ns[i].exchange(0, std::memory_order_relaxed);
+        const auto calls = totals.count[i].exchange(0, std::memory_order_relaxed);
+        if (calls == 0) continue;
+        n += std::snprintf(line + n, sizeof(line) - static_cast<std::size_t>(n), " %s %.1f (%llu, %.2f)", Names[i], static_cast<double>(ns) / 1e6, static_cast<unsigned long long>(calls), static_cast<double>(ns) / 1e3 / static_cast<double>(calls));
+    }
+    if (n > 0 && static_cast<std::size_t>(n) < sizeof(line)) {
+        n += std::snprintf(line + n, sizeof(line) - static_cast<std::size_t>(n), "; bindings: snapshots %llu (unwritten hits %llu, uploads %llu of %llu KiB, fresh buffers %llu), moved word buffers made %llu, descriptor writes %llu",
+            static_cast<unsigned long long>(totals.snapshots.exchange(0)), static_cast<unsigned long long>(totals.snapshotHits.exchange(0)), static_cast<unsigned long long>(totals.uploads.exchange(0)), static_cast<unsigned long long>(totals.uploadBytes.exchange(0) / 1024),
+            static_cast<unsigned long long>(totals.freshBuffers.exchange(0)), static_cast<unsigned long long>(totals.movedWordBuffers.exchange(0)), static_cast<unsigned long long>(totals.writes.exchange(0)));
+    }
+    std::fprintf(stderr, "%s\n", line);
+}
+
+inline void Add(Slot slot, std::uint64_t ns) {
+    auto& totals = Get();
+    totals.ns[slot].fetch_add(ns, std::memory_order_relaxed);
+    totals.count[slot].fetch_add(1, std::memory_order_relaxed);
+}
+
+inline void Count(std::atomic<std::uint64_t> Totals::*field, std::uint64_t value = 1) {
+    if (On()) (Get().*field).fetch_add(value, std::memory_order_relaxed);
+}
+
+// Times from construction (or the last Next) to the next Next or the destructor.
+class Timer {
+public:
+    explicit Timer(Slot first) : slot(first), on(On()) {
+        if (on) start = std::chrono::steady_clock::now();
+    }
+    void Next(Slot next) {
+        if (!on) return;
+        const auto now = std::chrono::steady_clock::now();
+        if (slot != SlotCount) Add(slot, static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(now - start).count()));
+        slot = next;
+        start = now;
+    }
+    void Stop() { Next(SlotCount); }
+    ~Timer() {
+        Stop();
+        if (on) Report();
+    }
+
+private:
+    Slot slot;
+    bool on;
+    std::chrono::steady_clock::time_point start{};
+};
+
+}

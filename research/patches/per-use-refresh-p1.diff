+        Require(draw->allocation.set == set && updates.calls.size() == calls, "an unchanged reused draw set was written again");
+        draw.reset();
+        complete();
+
+        draw = prepare(1, firstWords);
+        Require(draw->allocation.set == set, "a draw moving another buffer did not reuse the completed set");
+        const auto& moved = updates.calls.back();
+        Require(moved.buffers.size() == 2 && moved.images.empty(), "moving another buffer did not rewrite exactly the two changed descriptors");
+        const auto restored = moved.buffers.at({2u, 0u});
+        const auto before = original.buffers.at({2u, 0u});

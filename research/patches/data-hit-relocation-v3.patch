+bool Driver::relocatedLayoutKept(const DispatchVariant& kept, const DispatchVariant& moved) {
+    const auto page = [](std::uint64_t address) { return address / CapturePageBytes; };
+    const auto& runs = kept.runs;
+    for (std::size_t run = 0; run < runs.size() && run < kept.runBases.size() && run < moved.runs.size(); ++run) {
+        if (moved.runs[run] == runs[run]) continue;
+        const auto& [begin, end] = moved.runs[run];
+        if (end > begin && page(begin) != page(end - 1)) return false;
+        const auto base = kept.runBases[run];
+        const bool splitAfter = run + 1 < runs.size() && runs[run].second % CapturePageBytes == 0 && runs[run + 1].first == runs[run].second && run + 1 < kept.runBases.size() && kept.runBases[run + 1] == base;
+        const bool splitBefore = run > 0 && runs[run].first % CapturePageBytes == 0 && runs[run - 1].second == runs[run].first && kept.runBases[run - 1] == base;

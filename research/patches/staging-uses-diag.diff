+struct StagingUse {
+    std::uint64_t uses = 0;
+    bool swept = false;
+};
+
+AgcDriver::Mutex& stagingUseMutex() {
+    static AgcDriver::Mutex mutex;
+    return mutex;
+}
+
+std::map<std::pair<std::uint64_t, std::uint64_t>, StagingUse>& stagingUses() {
+    static std::map<std::pair<std::uint64_t, std::uint64_t>, StagingUse> uses;
+    return uses;
+}
+
+bool traceStagingCounts() {
+    static const bool trace = std::getenv("APS5_TRACE_STAGING_COUNTS") != nullptr;
+    return trace;
+}
+
+void countStaged(std::uint64_t begin, std::uint64_t end, bool swept) {
+    if (!traceStagingCounts()) return;
+    std::lock_guard lock(stagingUseMutex());
+    auto& use = stagingUses()[{begin, end}];
+    ++use.uses;
+    use.swept = use.swept || swept;
+}
+
+void reportStagingUses() {
+    if (!traceStagingCounts()) return;
+    std::vector<std::pair<std::pair<std::uint64_t, std::uint64_t>, StagingUse>> rows;
+    {
+        std::lock_guard lock(stagingUseMutex());
+        rows.assign(stagingUses().begin(), stagingUses().end());
+        stagingUses().clear();
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return (a.first.second - a.first.first) * a.second.uses > (b.first.second - b.first.first) * b.second.uses; });
+    std::uint64_t total = 0;
+    for (const auto& row : rows) total += (row.first.second - row.first.first) * row.second.uses;
+    AgcDriver::ProfilePrint_nid_no_patch("[staging-uses] last 10 s: %zu distinct ranges, %.0f MiB copied in\n", rows.size(), total / 1048576.0);
+    for (std::size_t index = 0; index < rows.size() && index < 12; ++index) {
+        const auto& [range, use] = rows[index];
+        const auto bytes = range.second - range.first;
+        AgcDriver::ProfilePrint_nid_no_patch("[staging-uses]   0x%llx+0x%llx %.2f MiB x%llu uses = %.0f MiB%s\n", static_cast<unsigned long long>(range.first), static_cast<unsigned long long>(bytes), bytes / 1048576.0, static_cast<unsigned long long>(use.uses), bytes * use.uses / 1048576.0, use.swept ? " swept" : "");
+    }
+}

+    Require(near->runs.front() == std::make_pair(std::uint64_t {0x10140u}, std::uint64_t {0x10144u}) && Driver::relocatedLayoutKept(variant, *near), "a base moved within its page and before the other table's run was refused");
+    const auto past = moved(0, 0x10100u, 0x10300u);
+    Require(!Driver::relocatedLayoutKept(variant, *past), "a base moved past the other table's run was kept, so its runs no longer sort like a fresh capture's");
+    const auto onto = moved(0, 0x10100u, 0x10200u);
+    Require(!Driver::relocatedLayoutKept(variant, *onto), "a base moved onto the other table's start was kept, so its runs no longer sort like a fresh capture's");
+    const auto across = moved(1, 0x10200u, 0x10ff8u);
+    Require(!Driver::relocatedLayoutKept(variant, *across), "a run moved across a 4 KiB page was kept, though a fresh capture splits it there");
+}

+    }
+    for (std::size_t run = 1; run < runs.size() && run < moved.runs.size(); ++run) {
+        const auto before = runs[run - 1].first <=> runs[run].first;
+        const auto after = moved.runs[run - 1].first <=> moved.runs[run].first;
+        if (before != after) return false;
+    }
+    return true;
+}

+std::shared_ptr<DispatchVariant> Driver::relocatedVariant(const DispatchVariant& variant, std::span<const std::pair<std::uint32_t, std::pair<std::uint32_t, std::uint32_t>>> moves) {
+    auto copy = std::make_shared<DispatchVariant>();

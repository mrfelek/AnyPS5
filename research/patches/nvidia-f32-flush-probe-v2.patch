 .../Translation/include/Translation/InstructionTranslator.hpp | 1 +
 .../Translation/include/Translation/TranslationContext.hpp    | 2 ++
 .../recompiler/Translation/src/InstructionTranslator.cpp      | 1 +
 core/shader/recompiler/Translation/src/VectorInstructions.cpp | 4 ++--
 docs/dev/ARCHITECTURE.md                                      | 2 +-
 6 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/core/shader/recompiler/Recompiler.cpp b/core/shader/recompiler/Recompiler.cpp
index fad7606ef9..56b3121d6f 100644
--- a/core/shader/recompiler/Recompiler.cpp
+++ b/core/shader/recompiler/Recompiler.cpp
@@ -245,6 +245,7 @@ IrProgram PrepareResourceProgram(const RecompileRequest& request, ShaderPreparat
     translateOptions.interpolationFunctions = supports(spv::CapabilityInterpolationFunction);
     translateOptions.floatMode = request.context.floatMode;
     translateOptions.float32FlushToZero = HardwareFloat32Flush(request);
+    translateOptions.float32FlushDeclared = supports(spv::CapabilityDenormFlushToZero);
     translateOptions.inputInfo = inputInfo;
     translateOptions.float32DenormPreserve = request.target.float32DenormPreserve;
 
diff --git a/core/shader/recompiler/Translation/include/Translation/InstructionTranslator.hpp b/core/shader/recompiler/Translation/include/Translation/InstructionTranslator.hpp
